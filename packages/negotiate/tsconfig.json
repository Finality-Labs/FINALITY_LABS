{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@finality/verification": ["../verification/dist/index.d.ts"],
      "@finality/verification/*": ["../verification/dist/*"],
      "@finality/chain/*": ["../chain/src/*"]
    }
  },
  "include": ["src"]
}