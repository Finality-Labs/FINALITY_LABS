      "default": "./dist/data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "echo 'shared: no tests'"
  },
  "dependencies": {
    "viem": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}