{
  "name": "@finality/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'orchestrator: no build needed (tsx runtime)'",
    "e2e": "tsx src/run-e2e.ts",
    "test": "tsx src/run-e2e.ts",
    "start": "tsx --env-file-if-exists=../../.env src/start-all.ts",
    "ui": "tsx --env-file-if-exists=../../.env src/ui-server.ts",
    "ui:live": "tsx --env-file=../../.env src/ui-server.ts",
    "proof:live": "tsx --env-file=../../.env src/run-live-proof.ts"
  },
  "dependencies": {
    "@finality/intake": "*",
    "@finality/negotiate": "*",
    "@finality/chain": "*",
    "@finality/reference-agent": "*",
    "@finality/verification": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.0"
  }
}
