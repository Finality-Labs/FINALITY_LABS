# Finality — chain (on-chain) configuration.
# Copy to .env in the repo root (or export these) to go LIVE on GOAT Network.
# Leave CHAIN_MODE=mock (or unset) for the default keyless behaviour.

# mock | live  — 'live' settles real transactions on GOAT.
CHAIN_MODE=mock

# goat-testnet (chainId 48816) | goat-mainnet (chainId 2345)
GOAT_NETWORK=goat-testnet

# RPC endpoint. Optional — defaults to the SDK's bundled RPC for the network:
#   goat-testnet -> https://rpc.testnet3.goat.network
#   goat-mainnet -> https://rpc.goat.network
# GOAT_RPC_URL=https://rpc.testnet3.goat.network

# REQUIRED for live: the settler/agent wallet private key (0x + 64 hex chars).
# This wallet signs the payment transfer + ERC-8004 feedback txs and must hold
# testnet gas (and the settle token, if GOAT_SETTLE_TOKEN is set).
# GOAT_PRIVATE_KEY=0x................................................................

# Optional: ERC-20 token to transfer as payment. Omit to settle in the native
# gas token via transferNative.
# GOAT_SETTLE_TOKEN=0x...
# GOAT_TOKEN_DECIMALS=6

# ERC-8004 registries (for reference; resolved by the SDK per network):
#   goat-testnet Identity   0x556089008Fc0a60cD09390Eca93477ca254A5522
#   goat-testnet Reputation 0xd9140951d8aE6E5F625a02F5908535e16e3af964

# ──────────────────────────────────────────────────────────────────────────────
# GOAT Flow x402 Configuration (Stage 1 — Testnet3 only)
# ──────────────────────────────────────────────────────────────────────────────
# All x402 settings are externalized — no hardcoded addresses, credentials, or
# network defaults. Configure these to enable real x402 settlement via GOAT Flow.
#
# REQUIRED for x402 settlement:
# GOAT_FLOW_X402_BASE_URL=https://flow-api.testnet3.goat.network
# GOAT_FLOW_X402_API_KEY=your_merchant_api_key_from_goat_flow_dashboard
# GOAT_FLOW_X402_API_SECRET=your_merchant_api_secret_from_goat_flow_dashboard
# GOAT_FLOW_X402_PAY_TO=0x...  # Receiving wallet address (payTo/merchant)
#
# OPTIONAL x402 settings:
# GOAT_FLOW_X402_SETTLE_TOKEN=0x...  # ERC-20 token contract (omit for native GOAT)
# GOAT_FLOW_X402_TOKEN_DECIMALS=18   # Decimals for settle token (default: 18)
# GOAT_FLOW_X402_TIMEOUT_MS=30000    # Request timeout in ms (default: 30000)
# GOAT_FLOW_X402_IDEMPOTENCY_KEY_PREFIX=finality_  # Prefix for idempotency keys
#
# Supported GOAT Testnet3 ERC-20 tokens (from SDK):
#   WGBTC:              0xBC10000000000000000000000000000000000000 (8 decimals)
#   GOAT (native):      0xbC10000000000000000000000000000000000001 (18 decimals)
#   BRIDGE:             0xBC10000000000000000000000000000000000003 (18 decimals)
#   BITCOIN:            0xbC10000000000000000000000000000000000005 (18 decimals)
#   OKU_SWAP_ROUTER:    0xaa52bB8110fE38D0d2d2AF0B85C3A3eE622CA455 (18 decimals)
#   OKU_QUOTER:         0x5911cB3633e764939edc2d92b7e1ad375Bb57649 (18 decimals)
#   OKU_POSITION_MGR:   0x743E03cceB4af2efA3CC76838f6E8B50B63F184c (18 decimals)
#   OKU_FACTORY:        0xcb2436774C3e191c85056d248EF4260ce5f27A9D (18 decimals)
#   LZ_ENDPOINT:        0x6F475642a6e85809B1c36Fa62763669b1b48DD5B (18 decimals)
#
# DO NOT hardcode wallet addresses, merchant credentials, or deploy contracts.
# This stage only prepares Finality for real x402 settlement.
